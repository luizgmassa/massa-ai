{
  "name": "massa-ai",
  "version": "1.33.0",
  "private": true,
  "author": "luizgmassa",
  "description": "massa-ai - Ancient knowledge keeper for modern code. Semantic search with 98% token reduction",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "bun scripts/diagnose.ts && bash scripts/ensure-ollama.sh",
    "predev:api": "bun scripts/diagnose.ts",
    "predev:mcp": "bun scripts/diagnose.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter @massa-ai/tools-api...",
    "dev:mcp": "bun run --filter @massa-ai/mcp-client dev",
    "start:api": "bun run --filter @massa-ai/tools-api start",
    "start:mcp": "bun run --filter @massa-ai/mcp-client start",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "bench:fixture": "bun run --filter @massa-ai/core bench:fixture:sicad",
    "bench:fixture:sicad": "bun run --filter @massa-ai/core bench:fixture:sicad",
    "bench:beir": "bun run --filter @massa-ai/core bench:beir",
    "bench:needles": "bun benchmarks/needles/run.ts",
    "bench:needles:gate": "NEEDLE_FLOOR_HIT1=0.4 NEEDLE_FLOOR_MRR=0.55 bun benchmarks/needles/run.ts --label ci-gate",
    "bench:parser": "bun benchmarks/parser/run.ts --baseline 5d43a96f4c0f1dfbd04ee7ae95f589f9b023bf03",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "generate:artifacts": "bun scripts/generate-skill-artifacts.ts && bun scripts/generate-subagent-artifacts.ts",
    "pretest:coverage": "bun run generate:artifacts",
    "test:coverage": "bun scripts/check-coverage.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist",
    "verify:model-ids": "bun scripts/verify-model-ids.ts",
    "verify:model-tokens": "bun scripts/verify-model-tokens.ts",
    "pretest:scripts": "bun run generate:artifacts",
    "test:scripts": "bun test scripts/__tests__ scripts/tests/*.test.ts && for f in scripts/tests/*.sh; do bash \"$f\" || exit 1; done",
    "pretest:plugins": "bun run generate:artifacts",
    "test:plugins": "bun test apps/claude-plugin/__tests__ apps/codex-plugin/__tests__ apps/cursor-plugin/__tests__ apps/opencode-plugin/__tests__",
    "diagnose": "bun scripts/diagnose.ts",
    "version:sync": "bun scripts/version-sync.ts",
    "verify:tree-sitter-source-dist": "bun scripts/verify-tree-sitter-grammars.ts",
    "verify:tree-sitter-package": "bun scripts/verify-tree-sitter-package-artifact.ts",
    "verify:tree-sitter-native": "bun scripts/verify-tree-sitter-grammars.ts && bun scripts/verify-tree-sitter-package-artifact.ts",
    "update-fixture-hashes": "bun scripts/update-fixture-hashes.ts",
    "install:skills": "bash scripts/install-skills.sh --apply",
    "uninstall:skills": "bash scripts/install-skills.sh --uninstall",
    "install:agents": "bash scripts/install-agents.sh",
    "install:harness": "bash scripts/install-harness.sh --all"
  },
  "keywords": [
    "mcp",
    "massa-ai",
    "thoth",
    "model-context-protocol",
    "semantic-search",
    "code-search",
    "token-optimization",
    "ai",
    "llm",
    "context",
    "vector-search",
    "knowledge-retrieval"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "oxlint": "1.76.0",
    "toml": "^4.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@tree-sitter-grammars/tree-sitter-kotlin",
    "@tree-sitter-grammars/tree-sitter-lua",
    "@tree-sitter-grammars/tree-sitter-markdown",
    "@tree-sitter-grammars/tree-sitter-yaml",
    "@tree-sitter-grammars/tree-sitter-zig",
    "tree-sitter",
    "tree-sitter-c",
    "tree-sitter-c-sharp",
    "tree-sitter-clojure-orchard",
    "tree-sitter-cpp",
    "tree-sitter-dart",
    "tree-sitter-elixir",
    "tree-sitter-erlang",
    "tree-sitter-go",
    "tree-sitter-haskell",
    "tree-sitter-html",
    "tree-sitter-java",
    "tree-sitter-javascript",
    "tree-sitter-json",
    "tree-sitter-ocaml",
    "tree-sitter-php",
    "tree-sitter-python",
    "tree-sitter-ruby",
    "tree-sitter-rust",
    "tree-sitter-scala",
    "tree-sitter-swift",
    "tree-sitter-typescript"
  ],
  "patchedDependencies": {
    "tree-sitter@0.25.0": "patches/tree-sitter@0.25.0.patch"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
