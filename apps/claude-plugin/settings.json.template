{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_description": "massa-ai plugin settings template. Merge the 'hooks' block into your project (.claude/settings.json) or user (~/.claude/settings.json) settings. The single massa-ai-hook binary replaces the 7 shell scripts; it fire-and-forgets POST lifecycle observations to the Tools API, always exits 0, and never blocks the agent. Set CLAUDE_PLUGIN_ROOT to the repo root, or replace it with an absolute path to apps/claude-plugin. Keep the _massaAiOwned marker on each block: it is how the installer recognises these entries as its own, so it can remove or replace them later instead of leaving them to fire alongside the plugin bundle. Pass the event type as the first argument (session-start, user-prompt-submit, agent-start, post-tool-use, pre-compact, stop). agent-start runs on PreToolUse for the Agent tool only and prints the dispatched massa-ai agent's model and effort; it posts nothing.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/massa-ai-hook.ts\" session-start"
          }
        ],
        "_massaAiOwned": true
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/massa-ai-hook.ts\" user-prompt-submit"
          }
        ],
        "_massaAiOwned": true
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/massa-ai-hook.ts\" agent-start"
          }
        ],
        "_massaAiOwned": true
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/massa-ai-hook.ts\" post-tool-use"
          }
        ],
        "_massaAiOwned": true
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/massa-ai-hook.ts\" stop"
          }
        ],
        "_massaAiOwned": true
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/massa-ai-hook.ts\" pre-compact"
          }
        ],
        "_massaAiOwned": true
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__massa-ai__list_projects",
      "mcp__massa-ai__project_map",
      "mcp__massa-ai__index_status",
      "mcp__massa-ai__analytics",
      "mcp__massa-ai__search",
      "mcp__massa-ai__search_definitions",
      "mcp__massa-ai__go_to_definition",
      "mcp__massa-ai__get_references"
    ]
  }
}
