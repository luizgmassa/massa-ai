.DS_Store

# Project-scoped harness installs. Every plugin installer supports --project,
# which writes its bundle into $(pwd)/<dotdir>: agents, skills, hooks.json and
# a real copy of the hook binary. Only .claude/ was listed here, so a --project
# install of any other host dropped untracked files into the working tree that
# `git add -A` would have committed — observed 2026-08-17, .cursor/ with 68
# files. This is install output, regenerated by re-running the installer; it is
# never a source.
.claude/
.codex/
.cursor/
.opencode/

# Testing
coverage/
.nyc_output/
*.lcov

# Temporary
tmp/
temp/
*.tmp

# Chrome/Vector DB
chroma/
chromadb/
.git-corrupted/

# Local MCP configuration (contains developer-specific paths)
.mcp.json

# Benchmark datasets
benchmarks/datasets/

# Generated plugin bundles (regenerate via `bun run generate:artifacts`)
apps/*-plugin/skills/massa-ai/
apps/*-plugin/skills/persona-router/
apps/*-plugin/skills/profile/
apps/*-plugin/skills/agents/
apps/*-plugin/agents/
apps/*-plugin/agent-profiles/
apps/codex-plugin/hooks/massa-ai-hook
apps/cursor-plugin/hooks/massa-ai-hook
apps/opencode-plugin/lib/opencode-config.cjs

# Generated workflow commands (regenerate via `bun run generate:artifacts`).
# Star + 6 static negations per shared directory keeps the hand-authored
# quick commands (def/find/graph/index/map/status) tracked while ignoring
# every marker-bearing generated file beside them (workflow-commands AD-018).
apps/claude-plugin/commands/*.md
!apps/claude-plugin/commands/def.md
!apps/claude-plugin/commands/find.md
!apps/claude-plugin/commands/graph.md
!apps/claude-plugin/commands/index.md
!apps/claude-plugin/commands/map.md
!apps/claude-plugin/commands/status.md
apps/codex-plugin/skills/*.md
!apps/codex-plugin/skills/def.md
!apps/codex-plugin/skills/find.md
!apps/codex-plugin/skills/graph.md
!apps/codex-plugin/skills/index.md
!apps/codex-plugin/skills/map.md
!apps/codex-plugin/skills/status.md
apps/cursor-plugin/skills/*/SKILL.md
!apps/cursor-plugin/skills/def/SKILL.md
!apps/cursor-plugin/skills/find/SKILL.md
!apps/cursor-plugin/skills/graph/SKILL.md
!apps/cursor-plugin/skills/index/SKILL.md
!apps/cursor-plugin/skills/map/SKILL.md
!apps/cursor-plugin/skills/status/SKILL.md
apps/opencode-plugin/command/
