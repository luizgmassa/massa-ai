{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "IDENTITY_ACCEPTANCE_DATABASE_URL",
        "HOOK_ATTRIBUTION_ACCEPTANCE_DATABASE_URL",
        "MASSA_AI_API_URL",
        "MASSA_AI_REINDEX_DEBOUNCE_MS",
        "MASSA_AI_MODEL_PROFILE",
        "MASSA_AI_API_KEY",
        "MASSA_AI_DEDICATED",
        "MASSA_AI_EXECUTOR_SANDBOX",
        "LLM_JUDGE_PROBE_URL",
        "OLLAMA_BASE_URL",
        "MASSA_AI_LLM_API_KEY",
        "MASSA_AI_LLM_BASE_URL",
        "MASSA_AI_LLM_CODE_MODEL",
        "MASSA_AI_LLM_DISABLE_THINK",
        "MASSA_AI_LLM_ENABLED",
        "MASSA_AI_LLM_MAX_OUTPUT_TOKENS",
        "MASSA_AI_LLM_MODEL",
        "MASSA_AI_LLM_PROMPT",
        "MASSA_AI_LLM_TEMPERATURE",
        "MASSA_AI_LLM_TIMEOUT_MS",
        "MASSA_AI_TEST_ALLOW_LLM",
        "MASSA_AI_TEST_CONFIG_HOME",
        "MASSA_AI_API_BASE",
        "MASSA_AI_API_PORT",
        "MASSA_AI_CO_RETRIEVAL_HOOK",
        "MASSA_AI_DATA_DIR",
        "MASSA_AI_EMBEDDED",
        "MASSA_AI_JOB_REAPER_INTERVAL_MS",
        "MASSA_AI_JOB_STALE_MS",
        "MASSA_AI_MEMORY_PATH",
        "MASSA_AI_PROJECT_ID",
        "MASSA_AI_PROXY_TIMEOUT_MS",
        "MASSA_AI_READ_FILE_MAX_LINES",
        "MASSA_AI_READ_FILE_ROOTS",
        "MASSA_AI_SCHEDULER_AUTO_IMPROVE_ENABLED",
        "MASSA_AI_SCHEDULER_AUTO_IMPROVE_INTERVAL_MS",
        "MASSA_AI_SCHEDULER_CONSOLIDATION_ENABLED",
        "MASSA_AI_SCHEDULER_CONSOLIDATION_INTERVAL_MS",
        "MASSA_AI_SCHEDULER_DECAY_ENABLED",
        "MASSA_AI_SCHEDULER_DECAY_INTERVAL_MS",
        "MASSA_AI_SCHEDULER_ENABLED",
        "MASSA_AI_SCHEDULER_MAX_CONCURRENT",
        "MASSA_AI_SCHEDULER_OBSERVATION_BRIDGE_ENABLED",
        "MASSA_AI_SCHEDULER_SAFE_DEFAULTS",
        "MASSA_AI_SCHEDULER_TICK_MS",
        "MASSA_AI_SKIP_GRAMMAR_INTEGRITY",
        "MASSA_AI_SSE_HEARTBEAT_MS",
        "MASSA_AI_SSE_MAX_DURATION_MS",
        "MASSA_AI_UPLOAD_DIR",
        "MASSA_AI_WEB_UI_TRUST_LOCAL",
        "RUN_E2E",
        "RUN_E2E_DESTRUCTIVE",
        "RUN_POSTGRES_TESTS"
      ]
    }
  }
}